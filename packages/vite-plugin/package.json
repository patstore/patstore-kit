{
  "name": "@patstore/vite-plugin",
	"version": "0.3.1",
  "description": "PatStore Vite plugin — SSG fetch, asset download, incremental sync",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patstore/patstore-kit.git",
    "directory": "packages/vite-plugin"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
		"@patstore/core": "workspace:^",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "vite": "^8.2.0"
  }
}
